# Text files are stored with LF and checked out with LF on every machine, so Windows and
# macOS stop reporting "LF will be replaced by CRLF" and diffs stay free of line-ending noise.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Never rewrite binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
*.gz binary
