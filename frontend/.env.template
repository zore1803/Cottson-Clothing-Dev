# Copy to .env.local and fill in. Everything here is read on the server unless it starts with
# NEXT_PUBLIC_. Never commit real values. See ../DEPLOY.md for where each one comes from.

# ---- Medusa (commerce backend) -------------------------------------------------------------
# Printed by `npx medusa exec ./src/scripts/seed-cottson.ts` in backend/apps/backend
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9100
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=
# Shared secret between this app and Medusa. Medusa only completes carts, and sends password-reset
# links here, for requests carrying it. Must equal CHECKOUT_SECRET in backend/apps/backend/.env
# (24+ characters, e.g. `openssl rand -hex 24`).
CHECKOUT_SECRET=

# ---- MongoDB Atlas (saved designs, quotes, staff roles, audit log) -----------------------------
MONGODB_URI=

# ---- Cloudinary (customer logos, design previews, superadmin product photos) --------------------
# Cloud name is the one on the dashboard, not the API key's name.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (Razorpay) -----------------------------------------------------------------------
# With both keys set, checkout uses real Razorpay. With none, development uses a dummy checkout that
# takes no money, and production keeps checkout switched off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when adding the webhook in the Razorpay dashboard
# (URL: <site>/api/payments/razorpay/webhook, events: payment.captured and order.paid)
RAZORPAY_WEBHOOK_SECRET=
# Optional override: "razorpay", "dummy" (no money is taken) or "off" (checkout disabled)
# PAYMENT_MODE=

# ---- Email over SMTP (staff invites and password-reset links) ---------------------------------
# Without SMTP_HOST and SMTP_FROM nothing is sent; the link is shown or logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="COTTSON <no-reply@example.com>"

# ---- Staff ---------------------------------------------------------------------------------------
# Comma-separated emails that are always superadmins. They cannot be demoted from the UI.
SUPERADMIN_EMAILS=

# ---- Site ----------------------------------------------------------------------------------------
# Public address of this site, used in links inside emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional ------------------------------------------------------------------------------------
# Redis for rate limits that every server instance shares. Must be reachable from where this app
# runs (on Vercel use a hosted Redis such as Upstash). Without it limits are counted in memory,
# per server instance.
# REDIS_URL=redis://localhost:6379
